# ============================================================
# MathMotion production .env — کنار docker-compose.prod.yaml (در backend/)
#   cp .env.prod.example .env && nano .env
# ============================================================

# دامنه‌ها (هر دو باید در آروان به IP سرور اشاره کنند)
API_HOST=api.mathmotion.ir
ADMIN_HOST=admin.mathmotion.ir

# آینه‌ی Docker Hub آروان برای دانلود ایمیج‌های پایه (روی سرور ایران ضروری است)
DOCKER_REGISTRY=docker.arvancloud.ir

# دیتابیس (فقط برای Ai-solver؛ جدا از دیتابیس لینگوفلو)
DB_USERNAME=mathmotion
DB_PASSWORD=
DB_NAME=mathmotion

# توکن ورود پنل ادمین — یک رشته‌ی تصادفی طولانی:  openssl rand -hex 32
ADMIN_TOKEN=

# هوش مصنوعی — اختیاری؛ بعداً از پنل ادمین هم قابل تنظیم است
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# کافه‌بازار — اختیاری تا وقتی خرید واقعی را تست کنی
BAZAAR_PACKAGE_NAME=com.mathmotion
BAZAAR_PRODUCT_ID=mathmotion_premium_unlock
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
# Usage limits — editable live in the admin panel («سهمیه و محدودیت‌ها»);
# these are only the fallbacks until something is saved there.
# FREE_QUOTA_PERIOD: daily (resets 00:00 Tehran) | lifetime
FREE_QUOTA_PERIOD=daily
FREE_DAILY_LIMIT=3
# Lifetime cap, used when FREE_QUOTA_PERIOD=lifetime (FREE_LIFETIME_LIMIT wins if both are set).
FREE_SOLVE_LIMIT=5
# Premium: only scans are capped per day (0 = no cap).
PREMIUM_DAILY_SCAN_LIMIT=30
